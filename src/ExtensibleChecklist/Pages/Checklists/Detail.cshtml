@page "{id:int}"
@model ExtensibleChecklist.Pages.Checklists.DetailModel
@using System.Globalization

@if (Model.Checklist is null)
{
    <div class="empty-state">
        <h2>Checklist not found</h2>
        <a href="/" class="btn btn-primary" style="margin-top: 1rem;">Back to Dashboard</a>
    </div>
    return;
}

@{
    var checklist = Model.Checklist;
    var total = checklist.Items.Count;
    var completed = checklist.Items.Count(i => i.Completed);
    var pct = total > 0 ? (int)Math.Round(100.0 * completed / total) : 0;

    // Group items by source template
    var grouped = checklist.Items
        .OrderBy(i => i.Order)
        .GroupBy(i => i.SourceTemplate)
        .ToList();
}

<div id="checklistApp" data-checklist-id="@checklist.Id" data-hide-completed="@checklist.HideCompleted.ToString().ToLower()">
    <!-- Header -->
    <div class="checklist-header">
        <div>
            <a href="/" class="link-accent no-print" style="font-size: 0.8rem;">&#8592; Back</a>
            <div class="checklist-title" id="checklistTitle">
                <h1 id="checklistName">@checklist.Name</h1>
                <button type="button" onclick="startEditName()" class="btn-icon btn-icon-edit no-print" title="Edit name" aria-label="Edit name">&#9998;</button>
            </div>
            <input type="text" value="@checklist.Name" class="checklist-name-input no-print"
                   id="checklistNameInput" style="display:none;"
                   onblur="saveChecklistName()"
                   onkeydown="handleNameKey(event)" />
        </div>
        <div class="checklist-actions no-print">
            <div class="user-menu" id="checklistMenu">
                <button type="button" class="user-menu-trigger checklist-menu-trigger" onclick="this.parentElement.classList.toggle('open')" title="More actions" aria-label="More actions">&#8943;</button>
                <div class="user-menu-dropdown" onclick="this.parentElement.classList.remove('open')">
                    <button type="button" onclick="toggleHideCompleted()" class="user-menu-item" id="hideBtn">
                        @(checklist.HideCompleted ? "Show All" : "Hide Completed")
                    </button>
                    <button type="button" onclick="toggleHideProgress()" class="user-menu-item" id="hideProgressBtn">
                        @(checklist.HideProgress ? "Show Progress" : "Hide Progress")
                    </button>
                    <button type="button" onclick="toggleBurndown()" class="user-menu-item" id="burndownBtn">
                        @(checklist.ShowBurndown ? "Hide Burndown" : "Show Burndown")
                    </button>
                    <button type="button" onclick="window.print()" class="user-menu-item">Print</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Progress -->
    <div class="progress-section no-print" id="progressSection" style="@(checklist.HideProgress ? "display:none;" : "")">
        <div class="progress-info">
            <span id="progressText">@completed of @total items completed</span>
            <span id="progressPct">@pct%</span>
        </div>
        <div class="progress-bar">
            <div class="progress-fill" id="progressFill" style="width: @pct%"></div>
        </div>
    </div>

    <!-- Burndown -->
    <div class="burndown-section no-print" id="burndownSection" style="@(checklist.ShowBurndown ? "" : "display:none;")">
        <div class="burndown-legend">
            <span><span class="burndown-swatch bd-swatch-created"></span>Created <strong id="bdCreatedCount"></strong></span>
            <span><span class="burndown-swatch bd-swatch-completed"></span>Completed <strong id="bdCompletedCount"></strong></span>
        </div>
        <div class="burndown-chart" id="burndownChart"></div>
    </div>

    <!-- Error banner -->
    <div id="errorBanner" class="toast toast-error no-print" style="display:none;"></div>

    <!-- Grouped items -->
    <div id="itemsView">
        @foreach (var group in grouped)
        {
            <div class="checklist-group" data-group="@group.Key">
                <div class="group-header">
                    <button type="button" class="group-toggle" onclick="toggleGroup(this)">
                        <h2>@group.Key</h2>
                        <span class="collapse-icon">&#9660;</span>
                    </button>
                    <button type="button" onclick="deleteGroup(this, @checklist.Id)" class="group-delete no-print" title="Delete group" aria-label="Delete group">&#10005;</button>
                </div>
                <div class="group-items">
                    @foreach (var item in group)
                    {
                        <div class="checklist-item @(item.Completed ? "item-completed" : "")"
                             data-item-id="@item.Id"
                             data-completed="@item.Completed.ToString().ToLower()"
                             data-created-at="@item.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss'Z'", CultureInfo.InvariantCulture)"
                             data-completed-at="@(item.CompletedAt?.ToString("yyyy-MM-ddTHH:mm:ss'Z'", CultureInfo.InvariantCulture))"
                             style="@(checklist.HideCompleted && item.Completed ? "display:none;" : "")">
                            <input type="checkbox" @(item.Completed ? "checked" : "")
                                   onchange="toggleItem(@item.Id, @checklist.Id)" class="item-checkbox" />
                            <input type="text" value="@item.Text" class="item-text"
                                   onblur="updateItemText(@item.Id, @checklist.Id, this)"
                                   onkeydown="if(event.key==='Enter') this.blur();" />
                            <div class="item-actions no-print">
                                <button onclick="moveItem(@item.Id, @checklist.Id, 'up')" class="btn-icon" title="Move up">&#9650;</button>
                                <button onclick="moveItem(@item.Id, @checklist.Id, 'down')" class="btn-icon" title="Move down">&#9660;</button>
                                <button onclick="deleteItem(@item.Id, @checklist.Id)" class="btn-icon btn-icon-danger" title="Delete">&#10005;</button>
                            </div>
                        </div>
                    }
                    <form class="add-item-form no-print" onsubmit="return addItem(event, '@group.Key', @checklist.Id)">
                        <span class="text-faint">+</span>
                        <input type="text" placeholder="Add item..." class="item-text add-item-input" />
                    </form>
                </div>
            </div>
        }

        <!-- Add group -->
        <div class="add-group no-print">
            <button type="button" onclick="showAddGroup()" id="addGroupBtn" class="btn btn-secondary btn-sm add-group-button">+ Add Group</button>
            <form id="addGroupForm" style="display:none;" onsubmit="return addGroup(event, @checklist.Id)" class="add-group-form">
                <input type="text" placeholder="Group name..." class="form-input" id="newGroupName" style="flex:1;" />
                <button type="submit" class="btn btn-primary btn-sm">Add</button>
                <button type="button" onclick="hideAddGroup()" class="btn btn-secondary btn-sm">Cancel</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const checklistId = @checklist.Id;
    let hideCompleted = @(checklist.HideCompleted ? "true" : "false");

    function sortAllGroups() {
        document.querySelectorAll('.group-items').forEach(group => {
            const form = group.querySelector('.add-item-form');
            const items = Array.from(group.querySelectorAll('.checklist-item'));
            items.forEach(item => {
                if (item.dataset.completed === 'true' && form) {
                    group.insertBefore(item, form);
                }
            });
        });
    }

    sortAllGroups();

    document.addEventListener('click', e => {
        const menu = document.getElementById('checklistMenu');
        if (!menu.contains(e.target)) menu.classList.remove('open');
    });

    function showError(msg) {
        const el = document.getElementById('errorBanner');
        el.textContent = msg;
        el.style.display = '';
        setTimeout(() => el.style.display = 'none', 5000);
    }

    function updateProgress() {
        const items = document.querySelectorAll('.checklist-item');
        const total = items.length;
        let completed = 0;
        items.forEach(el => { if (el.dataset.completed === 'true') completed++; });
        const pct = total > 0 ? Math.round(100 * completed / total) : 0;
        document.getElementById('progressText').textContent = `${completed} of ${total} items completed`;
        document.getElementById('progressPct').textContent = `${pct}%`;
        document.getElementById('progressFill').style.width = `${pct}%`;
        if (showBurndown) renderBurndown();
    }

    let showBurndown = @(checklist.ShowBurndown ? "true" : "false");

    async function toggleBurndown() {
        try {
            const res = await fetch(`/api/checklists/${checklistId}/show-burndown`, { method: 'POST' });
            if (!res.ok) throw new Error();
            const data = await res.json();
            showBurndown = data.showBurndown;
            document.getElementById('burndownBtn').textContent = showBurndown ? 'Hide Burndown' : 'Show Burndown';
            document.getElementById('burndownSection').style.display = showBurndown ? '' : 'none';
            if (showBurndown) renderBurndown();
        } catch {
            showError('Failed to toggle burndown');
        }
    }

    window.addEventListener('resize', () => { if (showBurndown) renderBurndown(); });

    function renderBurndown() {
        const chart = document.getElementById('burndownChart');
        const items = Array.from(document.querySelectorAll('.checklist-item'));
        const created = items.map(el => Date.parse(el.dataset.createdAt)).filter(t => !isNaN(t)).sort((a, b) => a - b);
        const completed = items
            .filter(el => el.dataset.completed === 'true')
            .map(el => Date.parse(el.dataset.completedAt))
            .filter(t => !isNaN(t))
            .sort((a, b) => a - b);

        document.getElementById('bdCreatedCount').textContent = created.length;
        document.getElementById('bdCompletedCount').textContent = completed.length;

        if (created.length === 0) {
            chart.innerHTML = '<p class="text-muted burndown-empty">No items yet.</p>';
            return;
        }

        const W = Math.max(chart.clientWidth, 280), H = 220;
        const m = { l: 32, r: 32, t: 12, b: 24 };
        const end = Date.now();
        const start = Math.min(created[0], end - 3600_000);
        const maxY = Math.max(created.length, 1);
        const yStep = Math.max(1, Math.ceil(maxY / 4));
        const yMax = yStep * Math.ceil(maxY / yStep);
        const x = t => m.l + (t - start) / (end - start) * (W - m.l - m.r);
        const y = v => m.t + (1 - v / yMax) * (H - m.t - m.b);
        const countAt = (times, t) => times.filter(v => v <= t).length;

        const stepPath = times => {
            let d = `M${x(start)},${y(0)}`;
            times.forEach((t, i) => { d += `H${x(t)}V${y(i + 1)}`; });
            return d + `H${x(end)}`;
        };

        const fmt = t => new Date(t).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
        const fmtFull = t => new Date(t).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });

        let grid = '';
        for (let v = 0; v <= yMax; v += yStep) {
            grid += `<line class="bd-grid" x1="${m.l}" x2="${W - m.r}" y1="${y(v)}" y2="${y(v)}"/>`;
            grid += `<text class="bd-axis" x="${m.l - 6}" y="${y(v)}" text-anchor="end" dominant-baseline="middle">${v}</text>`;
        }
        const xTicks = [start, start + (end - start) / 2, end];
        const anchors = ['start', 'middle', 'end'];
        xTicks.forEach((t, i) => {
            grid += `<text class="bd-axis" x="${x(t)}" y="${H - 6}" text-anchor="${anchors[i]}">${fmt(t)}</text>`;
        });

        // Direct end labels, nudged apart when they would overlap
        let yc = y(created.length), yd = y(completed.length);
        if (Math.abs(yc - yd) < 12) { yc -= 6; yd += 6; }

        chart.innerHTML = `
            <svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" role="img" aria-label="Items created vs completed over time">
                ${grid}
                <path class="bd-line bd-created" d="${stepPath(created)}"/>
                <path class="bd-line bd-completed" d="${stepPath(completed)}"/>
                <text class="bd-end-label" x="${W - m.r + 6}" y="${yc}" dominant-baseline="middle">${created.length}</text>
                <text class="bd-end-label" x="${W - m.r + 6}" y="${yd}" dominant-baseline="middle">${completed.length}</text>
                <g class="bd-hover" style="display:none;">
                    <line class="bd-crosshair" y1="${m.t}" y2="${H - m.b}"/>
                    <circle class="bd-dot bd-dot-created" r="4"/>
                    <circle class="bd-dot bd-dot-completed" r="4"/>
                </g>
                <rect class="bd-hit" x="${m.l}" y="${m.t}" width="${W - m.l - m.r}" height="${H - m.t - m.b}"/>
            </svg>
            <div class="burndown-tooltip" style="display:none;"></div>`;

        const svg = chart.querySelector('svg');
        const hover = svg.querySelector('.bd-hover');
        const tip = chart.querySelector('.burndown-tooltip');
        const hit = svg.querySelector('.bd-hit');

        hit.addEventListener('pointermove', e => {
            const px = e.clientX - svg.getBoundingClientRect().left;
            const t = start + (px - m.l) / (W - m.l - m.r) * (end - start);
            const c = countAt(created, t), d = countAt(completed, t);
            hover.style.display = '';
            hover.querySelector('.bd-crosshair').setAttribute('x1', px);
            hover.querySelector('.bd-crosshair').setAttribute('x2', px);
            hover.querySelector('.bd-dot-created').setAttribute('cx', px);
            hover.querySelector('.bd-dot-created').setAttribute('cy', y(c));
            hover.querySelector('.bd-dot-completed').setAttribute('cx', px);
            hover.querySelector('.bd-dot-completed').setAttribute('cy', y(d));
            tip.innerHTML = `<div class="bd-tip-date">${fmtFull(t)}</div>
                <div><span class="burndown-swatch bd-swatch-created"></span>Created <strong>${c}</strong></div>
                <div><span class="burndown-swatch bd-swatch-completed"></span>Completed <strong>${d}</strong></div>
                <div class="text-muted">Open <strong>${c - d}</strong></div>`;
            tip.style.display = '';
            const left = px + 12 + tip.offsetWidth > W ? px - 12 - tip.offsetWidth : px + 12;
            tip.style.left = `${left}px`;
            tip.style.top = `${m.t}px`;
        });
        hit.addEventListener('pointerleave', () => {
            hover.style.display = 'none';
            tip.style.display = 'none';
        });
    }

    async function toggleHideProgress() {
        try {
            const res = await fetch(`/api/checklists/${checklistId}/hide-progress`, { method: 'POST' });
            if (!res.ok) throw new Error();
            const data = await res.json();
            const hidden = data.hideProgress;
            document.getElementById('hideProgressBtn').textContent = hidden ? 'Show Progress' : 'Hide Progress';
            document.getElementById('progressSection').style.display = hidden ? 'none' : '';
        } catch {
            showError('Failed to toggle hide progress');
        }
    }

    async function toggleItem(itemId, clId) {
        const el = document.querySelector(`[data-item-id="${itemId}"]`);
        const wasCompleted = el.dataset.completed === 'true';
        const nowCompleted = !wasCompleted;

        // Visual update
        const prevCompletedAt = el.dataset.completedAt;
        el.dataset.completed = nowCompleted.toString();
        el.dataset.completedAt = nowCompleted ? new Date().toISOString() : '';
        el.classList.toggle('item-completed');
        if (hideCompleted && nowCompleted) el.style.display = 'none';
        updateProgress();

        // Move within group: completed to bottom, uncompleted to top
        const group = el.closest('.group-items');
        if (group) {
            if (nowCompleted) {
                // Move before the add-item form (bottom of items)
                const form = group.querySelector('.add-item-form');
                if (form) group.insertBefore(el, form);
            } else {
                // Move to top of group (before first completed item)
                const firstCompleted = group.querySelector('.checklist-item[data-completed="true"]');
                if (firstCompleted) {
                    group.insertBefore(el, firstCompleted);
                } else {
                    const form = group.querySelector('.add-item-form');
                    if (form) group.insertBefore(el, form);
                }
            }
        }

        try {
            const res = await fetch(`/api/checklists/${clId}/items/${itemId}/toggle`, { method: 'POST' });
            if (!res.ok) throw new Error();
        } catch {
            // Revert on error
            el.dataset.completed = wasCompleted.toString();
            el.dataset.completedAt = prevCompletedAt;
            el.classList.toggle('item-completed');
            el.querySelector('.item-checkbox').checked = wasCompleted;
            if (hideCompleted && nowCompleted) el.style.display = '';
            updateProgress();
            showError('Failed to toggle item');
        }
    }

    function startEditName() {
        const input = document.getElementById('checklistNameInput');
        const title = document.getElementById('checklistTitle');
        title.style.display = 'none';
        input.style.display = '';
        input.focus();
        input.select();
    }

    function handleNameKey(event) {
        if (event.key === 'Enter') {
            event.target.blur();
        } else if (event.key === 'Escape') {
            event.target.value = document.getElementById('checklistName').textContent;
            event.target.blur();
        }
    }

    async function saveChecklistName() {
        const input = document.getElementById('checklistNameInput');
        const nameEl = document.getElementById('checklistName');
        const title = document.getElementById('checklistTitle');
        const current = nameEl.textContent;
        const name = input.value.trim();

        input.style.display = 'none';
        title.style.display = '';

        if (!name) { input.value = current; return; }
        if (name === current) return;

        try {
            const res = await fetch(`/api/checklists/${checklistId}/name`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text: name })
            });
            if (!res.ok) throw new Error();
            nameEl.textContent = name;
            document.title = name;
        } catch {
            input.value = current;
            showError('Failed to update checklist name');
        }
    }

    async function updateItemText(itemId, clId, input) {
        const text = input.value.trim();
        if (!text) { location.reload(); return; }
        try {
            const res = await fetch(`/api/checklists/${clId}/items/${itemId}/text`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text })
            });
            if (!res.ok) throw new Error();
        } catch {
            showError('Failed to update item text');
            location.reload();
        }
    }

    async function deleteItem(itemId, clId) {
        if (!confirm('Delete this item?')) return;
        const el = document.querySelector(`[data-item-id="${itemId}"]`);
        el.remove();
        updateProgress();
        try {
            const res = await fetch(`/api/checklists/${clId}/items/${itemId}`, { method: 'DELETE' });
            if (!res.ok) throw new Error();
        } catch {
            showError('Failed to delete item');
            location.reload();
        }
    }

    async function moveItem(itemId, clId, direction) {
        const el = document.querySelector(`[data-item-id="${itemId}"]`);
        const container = el.parentElement;
        const items = Array.from(container.querySelectorAll('.checklist-item'));
        const idx = items.indexOf(el);

        if (direction === 'up' && idx > 0) {
            container.insertBefore(el, items[idx - 1]);
        } else if (direction === 'down' && idx < items.length - 1) {
            container.insertBefore(items[idx + 1], el);
        } else return;

        // Build reorder payload
        const allItems = Array.from(document.querySelectorAll('.checklist-item'));
        const updates = allItems.map((item, i) => ({ itemId: parseInt(item.dataset.itemId), order: i }));

        try {
            const res = await fetch(`/api/checklists/${clId}/reorder`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ updates })
            });
            if (!res.ok) throw new Error();
        } catch {
            showError('Failed to reorder items');
            location.reload();
        }
    }

    async function addItem(event, groupName, clId) {
        event.preventDefault();
        const form = event.target;
        const input = form.querySelector('.add-item-input');
        const text = input.value.trim();
        if (!text) return false;
        input.value = '';

        try {
            const res = await fetch(`/api/checklists/${clId}/items`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text, sourceTemplate: groupName })
            });
            if (!res.ok) throw new Error();
            location.hash = 'focus=' + encodeURIComponent(groupName);
            location.reload();
        } catch {
            showError('Failed to add item');
        }
        return false;
    }

    async function toggleHideCompleted() {
        try {
            const res = await fetch(`/api/checklists/${checklistId}/hide-completed`, { method: 'POST' });
            if (!res.ok) throw new Error();
            const data = await res.json();
            hideCompleted = data.hideCompleted;
            document.getElementById('hideBtn').textContent = hideCompleted ? 'Show All' : 'Hide Completed';

            document.querySelectorAll('.checklist-item').forEach(el => {
                if (el.dataset.completed === 'true') {
                    el.style.display = hideCompleted ? 'none' : '';
                }
            });
        } catch {
            showError('Failed to toggle hide completed');
        }
    }

    function toggleGroup(btn) {
        const header = btn.closest('.group-header');
        const items = header.nextElementSibling;
        const icon = btn.querySelector('.collapse-icon');
        if (items.style.display === 'none') {
            items.style.display = '';
            icon.textContent = '\u25BC';
        } else {
            items.style.display = 'none';
            icon.textContent = '\u25B6';
        }
    }

    async function deleteGroup(btn, clId) {
        const group = btn.closest('.checklist-group');
        const groupName = group.dataset.group;
        if (!confirm(`Delete group "${groupName}" and all of its items?`)) return;

        group.remove();
        updateProgress();

        try {
            const res = await fetch(`/api/checklists/${clId}/groups?groupName=${encodeURIComponent(groupName)}`, { method: 'DELETE' });
            if (!res.ok) throw new Error();
        } catch {
            showError('Failed to delete group');
            location.reload();
        }
    }

    function showAddGroup() {
        document.getElementById('addGroupBtn').style.display = 'none';
        document.getElementById('addGroupForm').style.display = 'flex';
        document.getElementById('newGroupName').focus();
    }

    function hideAddGroup() {
        document.getElementById('addGroupBtn').style.display = '';
        document.getElementById('addGroupForm').style.display = 'none';
    }

    function addGroup(event, clId) {
        event.preventDefault();
        const name = document.getElementById('newGroupName').value.trim();
        if (!name) return false;

        // Create group DOM
        const view = document.getElementById('itemsView');
        const addGroupDiv = view.querySelector('.add-group');

        const groupDiv = document.createElement('div');
        groupDiv.className = 'checklist-group';
        groupDiv.dataset.group = name;
        groupDiv.innerHTML = `
            <div class="group-header">
                <button type="button" class="group-toggle" onclick="toggleGroup(this)">
                    <h2>${name}</h2>
                    <span class="collapse-icon">&#9660;</span>
                </button>
                <button type="button" onclick="deleteGroup(this, ${clId})" class="group-delete no-print" title="Delete group" aria-label="Delete group">&#10005;</button>
            </div>
            <div class="group-items">
                <form class="add-item-form no-print" onsubmit="return addItem(event, '${name}', ${clId})">
                    <span class="text-faint">+</span>
                    <input type="text" placeholder="Add item..." class="item-text add-item-input" />
                </form>
            </div>`;

        view.insertBefore(groupDiv, addGroupDiv);
        hideAddGroup();
        document.getElementById('newGroupName').value = '';
        return false;
    }

    // Auto-focus the add-item input after reload
    if (location.hash.startsWith('#focus=')) {
        const groupName = decodeURIComponent(location.hash.substring(7));
        const group = document.querySelector(`.checklist-group[data-group="${CSS.escape(groupName)}"]`);
        if (group) {
            const input = group.querySelector('.add-item-input');
            if (input) input.focus();
        }
        history.replaceState(null, '', location.pathname + location.search);
    }

    if (showBurndown) renderBurndown();

</script>
}
