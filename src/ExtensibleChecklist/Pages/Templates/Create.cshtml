@page
@model ExtensibleChecklist.Pages.Templates.CreateModel

<div class="page-header">
    <div>
        <h1>Create New Template</h1>
        <p class="text-muted">Build a reusable checklist template with multiple items</p>
    </div>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="toast toast-error">@Model.ErrorMessage</div>
}

<form method="post" class="form-stack">
    <div class="form-group">
        <label for="Name">Template Name</label>
        <input type="text" id="Name" asp-for="Name" placeholder="e.g., Morning Routine" required class="form-input" />
    </div>

    <div class="form-group">
        <label for="ItemsText">Checklist Items</label>
        <p class="text-faint" style="margin-bottom: 0.5rem; font-size: 0.85rem;">Enter one item per line. Leading dashes are stripped.</p>
        <textarea id="ItemsText" asp-for="ItemsText" rows="15" placeholder="Enter one item per line..." class="form-textarea"></textarea>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Template</button>
        <a href="/Templates" class="btn btn-secondary">Cancel</a>
    </div>
</form>
