@page
@model ExtensibleChecklist.Pages.Templates.IndexModel

<nav class="tab-nav">
    <a href="/" class="tab-nav-item">Checklists</a>
    <a href="/Templates" class="tab-nav-item active">Templates</a>
</nav>

<div class="page-header">
    <p class="text-muted">Manage your reusable checklist templates</p>
    <div class="header-actions">
        <a href="/api/templates/export" class="btn btn-secondary">Export to Markdown</a>
        <a href="/Templates/Create" class="btn btn-primary">Create New Template</a>
    </div>
</div>

@if (Model.Templates.Count == 0)
{
    <div class="empty-state">
        <h2>No templates yet</h2>
        <p>Create your first template to get started.</p>
        <a href="/Templates/Create" class="btn btn-primary" style="margin-top: 1rem;">Create Template</a>
    </div>
}
else
{
    <div class="card-grid">
        @foreach (var template in Model.Templates)
        {
            <div class="card">
                <a href="/Templates/Edit/@template.Id" class="card-title">@template.Name</a>
                <p class="text-muted">@template.Items.Count @(template.Items.Count == 1 ? "item" : "items")</p>
                <p class="text-faint card-date">Created @template.CreatedAt.ToString("yyyy-MM-dd")</p>
                <div class="card-actions">
                    <a href="/Templates/Edit/@template.Id" class="btn btn-secondary">Edit</a>
                    <form method="post" asp-page-handler="Delete" style="flex:1; display:flex;"
                          onsubmit="return confirm('Delete &quot;@template.Name.Replace("'", "\\'")&quot;?');">
                        <input type="hidden" name="id" value="@template.Id" />
                        <button type="submit" class="btn btn-danger" style="flex:1;">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>
}

