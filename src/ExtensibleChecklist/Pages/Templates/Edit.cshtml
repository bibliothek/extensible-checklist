@page "{id:int}"
@model ExtensibleChecklist.Pages.Templates.EditModel

<div class="page-header">
    <div>
        <h1>Edit Template</h1>
        <p class="text-muted">Update your checklist template</p>
    </div>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="toast toast-error">@Model.ErrorMessage</div>
}

<form method="post" class="form-stack">
    <input type="hidden" asp-for="TemplateId" />

    <div class="form-group">
        <label for="Name">Template Name</label>
        <input type="text" id="Name" asp-for="Name" required class="form-input" />
    </div>

    <div class="form-group">
        <label for="ItemsText">Checklist Items</label>
        <p class="text-faint" style="margin-bottom: 0.5rem; font-size: 0.85rem;">One item per line. Leading dashes are stripped.</p>
        <textarea id="ItemsText" asp-for="ItemsText" rows="15" class="form-textarea"></textarea>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Template</button>
        <a href="/Templates" class="btn btn-secondary">Cancel</a>
    </div>
</form>
