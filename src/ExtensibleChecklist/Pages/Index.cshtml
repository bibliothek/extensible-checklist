@page
@model ExtensibleChecklist.Pages.IndexModel

<nav class="tab-nav">
    <a href="/" class="tab-nav-item active">Checklists</a>
    <a href="/Templates" class="tab-nav-item">Templates</a>
</nav>

<div class="page-header">
    <p class="text-muted">Your active checklists and quick actions</p>
    <div class="header-actions">
        <a href="/Checklists/Create" class="btn btn-primary">Create Checklist</a>
    </div>
</div>

@if (Model.Checklists.Count == 0 && Model.SharedWithMe.Count == 0)
{
    <div class="empty-state">
        <h2>No active checklists yet</h2>
        <p>Create a blank checklist or start from templates.</p>
        <a href="/Checklists/Create" class="btn btn-primary" style="margin-top: 1rem;">New Checklist</a>
    </div>
}

@if (Model.Checklists.Count > 0)
{
    <h2 class="section-title">Recent Checklists</h2>
    <div class="card-grid">
        @foreach (var checklist in Model.Checklists)
        {
            <partial name="_ChecklistCard" model="new ChecklistCardViewModel(checklist, true, null)" />
        }
    </div>
}

@if (Model.SharedWithMe.Count > 0)
{
    <h2 class="section-title section-title-spaced">Shared With You</h2>
    <div class="card-grid">
        @foreach (var checklist in Model.SharedWithMe)
        {
            var owner = Model.OwnerNames.TryGetValue(checklist.UserId, out var name) ? name : checklist.UserId;
            <partial name="_ChecklistCard" model="new ChecklistCardViewModel(checklist, false, owner)" />
        }
    </div>
}
