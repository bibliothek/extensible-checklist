<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Checklist</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="no-print">
        <div class="container header-content">
            <a href="/" class="logo">Checklist</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                var username = User.FindFirst("preferred_username")?.Value
                    ?? User.FindFirst("name")?.Value
                    ?? User.Identity.Name
                    ?? "unknown";
                <nav class="nav-links">
                    <a href="/" class="header-btn">Checklists</a>
                    <a href="/Templates" class="header-btn">Templates</a>
                </nav>
                <div class="user-info">
                    <div class="user-menu">
                        <button class="user-menu-trigger" onclick="this.parentElement.classList.toggle('open')">
                            <span>@username</span>
                            <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5l3 3 3-3"/></svg>
                        </button>
                        <div class="user-menu-dropdown">
                            <a href="@(ViewData["OidcIssuer"])" class="user-menu-item">Account</a>
                            <a href="@(ViewData["OidcIssuer"])account/logout" class="user-menu-item user-menu-item--danger">Logout</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <script>
        document.addEventListener('click', function(e) {
            document.querySelectorAll('.user-menu.open').forEach(function(menu) {
                if (!menu.contains(e.target)) menu.classList.remove('open');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
